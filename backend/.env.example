# Server Configuration
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000

# CORS - Comma-separated list of allowed origins (your Vercel frontend URLs)
# Example: https://your-app.vercel.app,https://admin.deutschlehrer.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_URL=https://your-backend.com/telegram-webhook

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mistral (Optional - for cost optimization)
MISTRAL_API_KEY=your-mistral-api-key-here

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=deutschlehrer-lessons
PINECONE_ENVIRONMENT=us-east-1-aws

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PREMIUM_PRICE_ID=price_your_premium_price_id_here

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin
ADMIN_PASSWORD=change-this-secure-password
ADMIN_EMAIL=admin@deutschlehrer.app

# Rate Limiting (Free Tier)
FREE_DAILY_MESSAGE_LIMIT=10
PREMIUM_DAILY_MESSAGE_LIMIT=999999

# Feature Flags
ENABLE_WEBAPP_CHAT=true
ENABLE_PDF_EXPORT=true
ENABLE_SMART_ROUTER=true
